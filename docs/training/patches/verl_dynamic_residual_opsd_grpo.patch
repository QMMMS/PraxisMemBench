+    def _collect_update_location_metrics(batch: KVBatchMeta, metrics: dict) -> None:
+        """Aggregate scalar Update scorer telemetry already present in reward output."""
+        rollout_indexes = {}
+        for index, tag in enumerate(batch.tags):
+            if tag.get("is_padding", False) or str(tag.get("task_type")) != "update":
+                continue
+            rollout_indexes[(tag.get("group_uid"), tag.get("rollout_index"))] = index
