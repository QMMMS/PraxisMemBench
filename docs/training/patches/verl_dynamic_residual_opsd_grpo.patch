+        )
+        metrics["update/location_correct_rate"] = correct / max(matched, 1.0)
+        metrics["update/location_wrong_rate"] = wrong / max(matched, 1.0)
+        metrics["update/duplicate_unit_rate"] = duplicate_rollouts / len(components)
+        metrics["update/new_skill_file_rate"] = new_skill_rollouts / max(skill_change_rollouts, 1)
